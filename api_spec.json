type":"string","example":"Male"},"addressLine1":{"type":"string","example":"No 21, Dyege Street"},"addressLine2":{"type":"string","example":"Akpehe"},"city":{"type":"string","example":"Makurdi"},"stateId":{"type":"string","format":"uuid","example":"a1b2c3d4-e5f6-7890-1234-567890abcdef"},"lgaId":{"type":"string","format":"uuid","example":"b2c3d4e5-f678-9012-3456-7890abcdef12"},"country":{"type":"string","example":"Nigeria"},"postalCode":{"type":"string","example":"970101"},"profilePhoto":{"type":"string","format":"binary"}}}}}},"responses":{"200":{"description":"Profile updated successfully"}}}},"/api/v1/drivers/onboarding/status":{"get":{"summary":"Check progress of all driver onboarding requirements","tags":["KYC"],"security":[{"BearerAuth":[]}],"responses":{"200":{"description":"Onboarding progress retrieved successfully"}}}},"/api/v1/drivers/me/vehicles":{"get":{"summary":"List driver registered vehicles","tags":["Drivers"],"security":[{"BearerAuth":[]}],"responses":{"200":{"description":"Vehicles retrieved successfully"}}},"post":{"summary":"Register a new vehicle","tags":["Drivers"],"security":[{"BearerAuth":[]}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["make","model","year","color","plateNumber","frontView","backView"],"properties":{"make":{"type":"string","example":"Toyota"},"model":{"type":"string","example":"Corolla"},"year":{"type":"integer","example":2021},"color":{"type":"string","example":"Black"},"plateNumber":{"type":"string","example":"ABC-123-XY"},"vehicleType":{"type":"string","description":"Physical type of the vehicle","example":"SEDAN"},"requestedCategory":{"type":"string","description":"Requested commercial category for the vehicle","enum":["BIKE","STANDARD","PREMIUM","VVIP"],"example":"PREMIUM"},"vin":{"type":"string","example":"1HGCR2F8XJA00000"},"frontView":{"type":"string","format":"binary","description":"Front view image of the vehicle"},"backView":{"type":"string","format":"binary","description":"Back view image of the vehicle"}}}}}},"responses":{"210":{"description":"Vehicle registered successfully (defaults to PENDING status)"}}}},"/api/v1/drivers/me/vehicles/{id}":{"patch":{"summary":"Update vehicle metadata","tags":["Drivers"],"security":[{"BearerAuth":[]}],"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string"},"description":"Vehicle ID"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"color":{"type":"string","example":"White"},"plateNumber":{"type":"string","example":"XYZ-987-AB"}}}}}},"responses":{"200":{"description":"Vehicle updated successfully"}}}},"/api/v1/drivers/kyc/documents":{"post":{"summary":"Upload a single KYC document","description":"Accepts multipart/form-data. Allowed formats are JPEG, PNG, and PDF up to 2MB.","tags":["KYC"],"security":[{"BearerAuth":[]}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["documentType","file"],"properties":{"documentType":{"type":"string","enum":["DRIVER_LICENSE","VEHICLE_REGISTRATION","VEHICLE_INSURANCE","IDENTITY_DOCUMENT","PROOF_OF_ADDRESS","VEHICLE_FRONT","VEHICLE_BACK","VEHICLE_PHOTO","CAR_FRONT","CAR_BACK"],"example":"DRIVER_LICENSE"},"documentNumber":{"type":"string","example":"DL-12345678"},"issuedAt":{"type":"string","format":"date","example":"2023-01-01"},"expiresAt":{"type":"string","format":"date","example":"2028-01-01"},"file":{"type":"string","format":"binary"}}}}}},"responses":{"201":{"description":"Document uploaded successfully (resets status to PENDING)"},"400":{"description":"Missing parameters, unsupported type, file too large, or invalid format"}}}},"/api/v1/drivers/kyc/status":{"get":{"summary":"Get overall KYC, document approval list, and background-check statuses","tags":["KYC"],"security":[{"BearerAuth":[]}],"responses":{"200":{"description":"KYC status retrieved successfully"}}}},"/api/v1/drivers/{driverId}/kyc/status":{"get